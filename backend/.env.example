# Copia este archivo como backend/.env y ajusta los valores.
# Conexión a PostgreSQL (en Docker el host es "db").
DATABASE_URL=postgresql+psycopg://sabia:sabia_local@localhost:5432/sabia
# Clave para firmar los JWT. Genera una nueva: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion
# Duración del token en minutos (30 días: la app debe funcionar sin señal en el campo)
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Cargar los datos semilla de database/seeds al arrancar
SEED_ON_START=true
# Carpeta de datos semilla (vacío = <repo>/database/seeds)
SEEDS_DIR=
# Perfiles de demostración (Sofía, Carlos, Aura, Mamo Senen, Faustina, Patrón Marino). En producción: false
ENABLE_DEMO_PROFILES=true
# Contraseña de las cuentas de prueba (en producción usa una distinta y no la publiques)
DEMO_PASSWORD=aluna2026
# production = exige SECRET_KEY aleatoria (32+ caracteres) y oculta /api/docs
ENVIRONMENT=development
# Las claves de proveedores de IA (si algún día se conecta un LLM a Ceiba) van SOLO aquí, nunca en VITE_*.
