# Configuración de entorno — ALUNA IA (Módulo SABIA & CEIBA)
# IMPORTANTE: Nunca coloques claves privadas de proveedores de IA (OpenAI/Gemini/Anthropic) en variables VITE_*
# ya que cualquier variable VITE_* se expone en el cliente compilado. Esas claves viven solo en backend/.env.

VITE_APP_NAME="ALUNA IA — SABIA & CEIBA"
# Base de la API. "/api/v1" = mismo origen (Vite en desarrollo y nginx en Docker la reenvían al backend).
VITE_API_BASE_URL="/api/v1"
# Selector rápido de perfiles demo en el menú (Sofía, Carlos, Aura, Mamo Senen…). "false" = las personas
# crean su cuenta o entran como visitantes; las cuentas de prueba siguen en «Iniciar sesión» (plegadas).
VITE_ENABLE_DEMO_PROFILES="false"
# Solo para `npm run dev`: dónde corre el backend FastAPI
VITE_PROXY_API="http://localhost:8000"
